# WebSocket relay config
RELAY_PORT=3001

# WebSocket URL for the frontend client (default: ws://localhost:3001)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# === massive.com Real-Time Market Data ===
# Get your API key at https://massive.com
MASSIVE_API_KEY=your_massive_api_key_here

# WebSocket endpoint (stocks for stock tickers, forex for forex pairs)
# Default: wss://socket.massive.com/forex
MASSIVE_WS_URL=wss://socket.massive.com/forex

# Ticker symbol (use XAU-USD for gold on forex, or stock ticker for stocks)
MASSIVE_TICKER=XAU-USD

# Event types to subscribe to (comma-separated)
# Forex: C (quotes), CAS (per-second aggregates), CA (per-minute aggregates)
# Stocks: Q (quotes), A (per-second aggregates), AM (per-minute aggregates)
MASSIVE_SUBSCRIPTIONS=C,CAS

# === News API (optional) ===
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key
NEXT_PUBLIC_ALPHA_VANTAGE_KEY=your_alpha_vantage_key
